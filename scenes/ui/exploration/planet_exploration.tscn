[sub_resource type="Resource" id="ObserveShort"]
script = ExtResource("3_orxqf")
location_id = &"surface"
text = "你停下来，观察这片星球的上层。

远处的轮廓在黑暗中保持沉默。"

[sub_resource type="Resource" id="ObserveLong"]
script = ExtResource("3_orxqf")
location_id = &"surface"
long_press = true
duration_seconds = 5.0
text = "你花了一些时间，仔细观察这里。

远处的轮廓没有变化。你开始留意那些微小的差异。

有些现象只有在特定的时间、特定的地点才会发生。

你记下眼前的状态，准备在之后的探索中再次比较。"

[sub_resource type="Resource" id="ProbeShort"]
script = ExtResource("3_orxqf")
location_id = &"surface"
action_id = "probe"
duration_seconds = 10.0
text = "探测完成。

当前地点没有出现新的信号。"

[sub_resource type="Resource" id="ProbeLong"]
script = ExtResource("3_orxqf")
location_id = &"surface"
action_id = "probe"
long_press = true
duration_seconds = 30.0
text = "你延长探测，反复核对信号。

这一次没有发现新的线索。"

[sub_resource type="Resource" id="WaitShort"]
script = ExtResource("3_orxqf")
location_id = &"surface"
action_id = "wait"
duration_seconds = 10.0
text = "你在原地等待，时间加速流逝。

关闭文本框以结束等待。"

[sub_resource type="Resource" id="WaitLong"]
script = ExtResource("3_orxqf")
location_id = &"surface"
action_id = "wait"
long_press = true
duration_seconds = 60.0
text = "你在原地等待了一分钟。

时间继续流逝。"

